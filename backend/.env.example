# 复制为 .env 后按需修改
SECRET_KEY=please-change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./data/app.db

# SMTP（留空时验证码打印到控制台）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_USE_TLS=1

# 验证码有效期（秒）
CODE_TTL_SECONDS=300
# JWT 有效期（天）
JWT_TTL_DAYS=7

# 首次启动自动创建的超级管理员（邮箱留空则不创建）
SUPERADMIN_EMAIL=
SUPERADMIN_USERNAME=超级管理员

# 网站信息（页脚 / 下载按钮）
CONTACT_EMAIL=
GITHUB_URL=https://github.com/SmartTeachCN/CSES
CLASSISLAND_RELEASE_URL=https://github.com/ClassIsland/ClassIsland/releases/latest
CLASSWIDGETS_RELEASE_URL=https://github.com/Class-Widgets/Class-Widgets/releases/latest

# NTP 时间同步（每校一个 UDP 端口，用于对齐学校打铃）
# 设为 0 可整体关闭，Web 服务照常运行
NTP_ENABLED=1
# UDP 监听地址
NTP_HOST=0.0.0.0
# 起始端口，按学校创建顺序依次分配；单校部署想让 Windows 原生时间服务直连可改成 123
NTP_BASE_PORT=11123
NTP_MAX_SERVERS=256
# 对外展示给客户端的主机名/IP；部署在反向代理后必填，留空则用请求的 Host
NTP_PUBLIC_HOST=
# 新建学校 NTP 服务时的默认时区
NTP_DEFAULT_TIMEZONE=Asia/Shanghai
# 配置热更新间隔（秒）；网页上改动会立即生效，此值只是兜底
NTP_REFRESH_SECONDS=30
